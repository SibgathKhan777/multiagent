{
  "name": "multiagent-ai-factory",
  "version": "1.0.0",
  "description": "Distributed Multi-Agent AI Software Development System",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest --verbose --forceExit",
    "eval": "node evals/run.js",
    "eval:compare": "node evals/compare.js",
    "eval:codegen": "node evals/run-codegen.js",
    "eval:codegen:mock": "node evals/run-codegen.js --mode mock --behavior mixed --label codegen-mock",
    "eval:tools": "node evals/run-tools.js",
    "eval:validate": "node evals/validate-results.js"
  },
  "keywords": [
    "ai",
    "multi-agent",
    "software-factory"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "archiver": "^7.0.1",
    "axios": "^1.15.1",
    "bullmq": "^5.0.0",
    "dotenv": "^16.4.0",
    "express": "^4.18.0",
    "groq-sdk": "^1.1.1",
    "ioredis": "^5.3.0",
    "langfuse": "^3.39.2",
    "mongoose": "^8.0.0",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.3.0"
  },
  "engines": {
    "node": ">=18.14"
  }
}
