# ── AI Provider ────────────────────────────────────────────────────────────────
# Options: groq | gemini | python-ai | simulated
PROVIDER=groq

# ── Groq (https://console.groq.com) ───────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Google Gemini ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Python AI Service (hybrid mode) ───────────────────────────────────────────
# URL of the running multiagent-ai-service (FastAPI + CrewAI + LangGraph).
# Required when PROVIDER=python-ai.
AI_SERVICE_URL=http://localhost:8000

# ── Infrastructure ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/multiagent
REDIS_URL=redis://localhost:6379

# ── Pipeline tuning ───────────────────────────────────────────────────────────
QUALITY_THRESHOLD=70
MAX_ITERATIONS=3
LOG_LEVEL=info

# ── Tracing (optional) ────────────────────────────────────────────────────────
# Spans are always written to logs/traces.jsonl (TRACE_FILE=off to disable).
# Set both keys to also export to Langfuse (cloud or self-hosted).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASEURL=https://cloud.langfuse.com

# ── MCP (optional) ─────────────────────────────────────────────────────────────
# true = the pipeline validates code and runs sandboxed tests through the MCP server
# (src/mcp/server.js, stdio). Standalone: node src/mcp/server.js
# MCP_ENABLED=false
# MCP_ALLOWED_TOOLS=validate_code,list_project_files,read_project_file   # run_unit_tests must be listed explicitly
# MCP_WORKSPACE=/absolute/path/for/file/tools

# ── API auth (optional) ───────────────────────────────────────────────────────
# If set, /api/* (except /api/health) requires "Authorization: Bearer <key>" or "X-API-Key: <key>".
# The bundled dashboard cannot send it; use curl or a proxy. Leave unset for local development.
# API_KEY=
